          05 FILLER PIC X(45) VALUE SPACES.
       01 HD2.
          05 FILLER PIC X(27) VALUE SPACES.
          05 FILLER PIC X(18) VALUE ALL '-'.
          05 FILLER PIC X(45) VALUE SPACES.
       01 HD4.
          05 FILLER PIC X(90) VALUE ALL '-'.
       01 HD3.
          05 FILLER PIC X(13) VALUE 'EMPLOYEE CODE'.
          05 FILLER PIC X(4) VALUE SPACES.
          05 FILLER PIC X(13) VALUE 'EMPLOYEE NAME'.
          05 FILLER PIC X(4) VALUE SPACES.
          05 FILLER PIC X(15) VALUE 'EMPLOYEE SALARY'.
          05 FILLER PIC X(4) VALUE SPACES.
          05 FILLER PIC X(12) VALUE 'EMPLOYEE PAN'.
          05 FILLER PIC X(25) VALUE SPACES.
       01 FT1.
          05 FILLER PIC X(90) VALUE ALL '-'.
       01 FT2.
          05 FILLER PIC X(26) VALUE SPACES.
          05 FILLER PIC X(5) VALUE 'TOTAL'.
          05 FILLER PIC X(3) VALUE SPACES.
          05 TOT-SAL PIC 9(6) VALUE 0.
          05 FILLER PIC X(41) VALUE SPACES.

       01 GT1.
          05 FILLER PIC X(90) VALUE ALL '-'.
       01 GT2.
          05 FILLER PIC X(21) VALUE SPACES.
          05 FILLER PIC X(10) VALUE 'GRANDTOTAL'.
          05 FILLER PIC X(3) VALUE SPACES.
          05 GRAND-SAL PIC 9(6) VALUE 0.
          05 FILLER PIC X(50) VALUE SPACES.
       PROCEDURE DIVISION.
           DISPLAY 'MUSKAN'.
           PERFORM OPEN-PARA.
           PERFORM READ-PARA.
           PERFORM PROCESS-PARA UNTIL EOF = 'Y'.
           PERFORM CLOSE-PARA.
           STOP RUN.

       OPEN-PARA.
           OPEN INPUT INFILE.
           OPEN OUTPUT OUTFILE.
       READ-PARA.
           READ INFILE AT END MOVE 'Y' TO EOF.
       WRITE-HEADER.
           WRITE OUTFILE-REC FROM HD1.
           WRITE OUTFILE-REC FROM HD2.
           WRITE OUTFILE-REC FROM HD3.
           WRITE OUTFILE-REC FROM HD4.
           MOVE 0 TO ALL-TOT.
           MOVE 0 TO REC-CNT.
       PROCESS-PARA.
           IF REC-CNT = 0
              PERFORM WRITE-HEADER
           END-IF.

           MOVE INFILE-EMPNO TO OUTFILE-EMPNO.
           MOVE INFILE-EMPNM TO OUTFILE-EMPNM.
           MOVE INFILE-EMPSAL TO OUTFILE-EMPSAL.
           MOVE INFILE-PAN TO OUTFILE-PAN.
           WRITE OUTFILE-REC.
           MOVE SPACES TO OUTFILE-REC.

           COMPUTE ALL-TOT = ALL-TOT + INFILE-EMPSAL.
           COMPUTE GRAND-TOT = GRAND-TOT + INFILE-EMPSAL.
           ADD 1 TO REC-CNT.
           PERFORM READ-PARA.

           IF REC-CNT = 5 OR EOF = 'Y'
              WRITE OUTFILE-REC FROM FT1
              MOVE ALL-TOT TO TOT-SAL
              WRITE OUTFILE-REC FROM FT2
              MOVE 0 TO REC-CNT
              MOVE 0 TO ALL-TOT
           END-IF.
       CLOSE-PARA.
           WRITE OUTFILE-REC FROM FT1.
           MOVE GRAND-TOT TO GRAND-SAL.
           WRITE OUTFILE-REC FROM GT2.
           CLOSE INFILE.
           CLOSE OUTFILE.
