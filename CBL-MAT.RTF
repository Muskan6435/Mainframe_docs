\par \tab   RECORD KEY IS I-EMP-NO
\par }\pard \ltrpar\qj \fi720\li0\ri0\widctlpar\brdrt\brdrs\brdrw45\brsp20 \brdrl\brdrs\brdrw45\brsp80 \brdrb\brdrs\brdrw45\brsp20 \brdrr\brdrs\brdrw45\brsp80 \wrapdefault\faauto\adjustright\rin0\lin0\itap0\pararsid16136647 {\rtlch\fcs1 \af1\afs20 \ltrch\fcs0 
